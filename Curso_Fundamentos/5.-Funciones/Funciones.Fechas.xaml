    <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="434,173" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;La Fecha de hoy en horario ES: &quot; + dt_Actual_Fecha.ToString]" />
