    <ui:Comment sap:VirtualizedContainerService.HintSize="434,411" sap2010:WorkflowViewState.IdRef="Comment_1" Text="Funciones de Fechas.&#xA;System.DateTime&#xA;DateTime: es un tipo de variable, que te permite almacenar la fecha y hora.&#xA;Para crearla con la fecha y hora actual se utiliza la función Now al definirla. También podemos almacenar sólo la fecha actual con la función “Datetime.Today”.&#xA;En función del lugar donde vivamos, el formato de datetime estándar, cambia. Para indicar el estándar que queremos utilizar, debemos modificar el código de cultura en “System.Threading.Thread.CurrentThread.CurrentCulture” asignándole el valor “New System.Globalization.CultureInfo(&quot;es-ES&quot;)” para España. Es posible que necesitemos importar la librerías “System.Globalization” Esto lo podremos hacer desde el panel “Imports”." />
    <Assign sap:VirtualizedContainerService.HintSize="434,114" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="s:DateTime">[dt_Actual_Fecha_Hora]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:DateTime">[Now]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="434,173" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;La Fecha de hoy en horario US: &quot; + dt_Actual_Fecha_Hora.ToString]" />
    <Assign sap:VirtualizedContainerService.HintSize="434,114" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="sg:CultureInfo">[System.Threading.Thread.CurrentThread.CurrentCulture]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sg:CultureInfo">[New System.Globalization.CultureInfo("es-ES")]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="434,173" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;La Fecha de hoy en horario ES: &quot; + dt_Actual_Fecha_Hora.ToString]" />
    <Assign sap:VirtualizedContainerService.HintSize="434,114" sap2010:WorkflowViewState.IdRef="Assign_3">
