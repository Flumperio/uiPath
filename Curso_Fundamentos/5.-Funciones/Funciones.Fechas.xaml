    <ui:Comment sap:VirtualizedContainerService.HintSize="434,107" sap2010:WorkflowViewState.IdRef="Comment_2" Text="Investigar sobre las funciones: AddDays(n), Day, Month y Year" />
    <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="434,164" sap2010:WorkflowViewState.IdRef="LogMessage_5" Message="[&quot;La fecha de hoy es: &quot; + &#x9;dt_Actual_Fecha.ToString + &quot;Y la hora es:&quot; + dt_Actual_Hora.ToString + vbCrLf + &quot;Pasado mañana será: &quot; + dt_Actual_Fecha.AddDays(2).ToString + vbCrLf +&#xA;&quot;El día de hoy es: &quot; + dt_Actual_Fecha_Hora.Day.ToString + vbCrLf + &#xA;&quot;Es mes de hoy es: &quot; + dt_Actual_Fecha_Hora.Month.ToString + vbCrLf + &#xA;&quot;El año de hoy es: &quot; + dt_Actual_Fecha_Hora.Year.ToString + vbCrLf + &#xA;&quot;Son las: &quot; + dt_Actual_Fecha_Hora.Hour.ToString + &quot; con &quot; + dt_Actual_Fecha_Hora.Minute.ToString + &quot; minutos&quot; + &quot;y &quot; + dt_Actual_Fecha_Hora.Second.ToString + &quot; segundos.&quot; + vbCrLf + &#xA;&quot;Que tengas un buen &quot; + dt_Actual_Fecha_Hora.DayOfWeek.ToString]" />
